FROM golang:1.27-alpine AS goose-build
RUN CGO_ENABLED=0 go install -tags='no_clickhouse no_libsql no_mssql no_mysql no_sqlite3 no_vertica no_ydb' github.com/pressly/goose/v3/cmd/goose@v3.28.0

FROM alpine:3.24 AS goose
USER 65532:65532
COPY --from=goose-build /go/bin/goose /goose
ENTRYPOINT ["/goose"]

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /server ./cmd/api
RUN CGO_ENABLED=0 go build -trimpath -o /worker ./cmd/worker

FROM alpine:3.24
USER 65532:65532
COPY --from=build /server /server
COPY --from=build /worker /worker
EXPOSE 8081
ENTRYPOINT ["/server"]
